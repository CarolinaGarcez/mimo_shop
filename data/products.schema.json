{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo do Mimo Digital",
  "description": "Produtos reais publicados ou em preparação. Campos comerciais permanecem opcionais até serem confirmados.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "category", "description", "image", "status", "featured"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "category": { "type": "string", "enum": ["livros-colorir", "cartoes-digitais", "calendarios-organizacao", "personalizados"] },
      "subcategory": { "type": "string", "enum": ["natal", "infantil", "antiestresse"] },
      "shortDescription": { "type": "string" },
      "description": { "type": "string", "minLength": 1 },
      "fullDescription": { "type": "string" },
      "image": { "type": "string" },
      "imageAlt": { "type": "string" },
      "previewImages": { "type": "array", "items": { "type": "string" } },
      "kitContents": { "type": "array", "items": { "type": "string" } },
      "price": { "type": "number", "minimum": 0 },
      "format": { "type": "string" },
      "pageCount": { "type": "integer", "minimum": 1 },
      "fileCount": { "type": "integer", "minimum": 1 },
      "status": { "type": "string", "enum": ["draft", "published"] },
      "featured": { "type": "boolean" },
      "detailsUrl": { "type": "string", "format": "uri-reference" },
      "url": { "type": "string", "format": "uri-reference", "deprecated": true },
      "checkoutUrl": { "type": "string" }
    }
  }
}
